venv/
.venv/
__pycache__/
*.pyc
.env
.pytest_cache/
build/
dist/
*.spec
assets/screenshots/*.png
logs/
temp_speech_*.mp3
.freebuff/

# Control plane runtime database
data/control.db
data/control.db-wal
data/control.db-shm

# Encryption key for the control plane secret store
data/secret.key

# The logged-in browser profile. Treat it like a password store.
data/browser_profile/
data/browser_last.png

# What JARVIS learned about sites you visit
data/site_notes.json

# Google OAuth client secret from the Cloud Console, and the tokens it earns.
# These identify you to Google. Keep them on the machine that uses them.
credentials.json
token.json
token_workspace.json
data/chroma_db/chroma.sqlite3

# Local vector store and the Telegram poller's lock file: both are
# generated at runtime and conflict on every merge.
data/chroma_db/
data/.telegram.pid

# Credentials for this machine. config.json is committed and must stay
# free of tokens; anything here overrides it.
config.local.json

# Packaging artifacts
vave.egg-info/
